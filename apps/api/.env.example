# Plantilla de variables del backend. Copia este archivo a `.env` y completa con
# los valores REALES. El `.env` está en .gitignore: NUNCA lo subas al repo.
# En producción, estas variables se cargan en Railway (Service api -> Variables).

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?schema=public"

# --- JWT (autenticación del panel admin) ---
# Genera uno propio y largo, p. ej.: openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# --- Servidor ---
PORT=4024
CORS_ORIGIN="http://localhost:3000"
# URL pública del backend (arma las URLs del proxy de imágenes)
API_PUBLIC_URL="http://localhost:4024"

# --- Izipay (pasarela de tarjeta, STUB fail-closed) ---
# Debe quedar apagado en cualquier entorno público hasta integrar la firma real.
IZIPAY_STUB_HABILITADO="false"

# --- Wasabi (almacenamiento S3-compatible de imágenes) ---
WASABI_ENDPOINT="https://s3.<region>.wasabisys.com"
WASABI_REGION="<region>"
WASABI_BUCKET="<nombre-del-bucket>"
WASABI_PREFIX=""
WASABI_ACCESS_KEY="<access-key-id>"
WASABI_SECRET_KEY="<secret-access-key>"

# --- SMTP (aviso de nuevos reclamos por email; opcional) ---
# Sin estas variables, la notificación queda desactivada (fail-safe).
SMTP_HOST="smtp.tu-proveedor.com"
SMTP_PORT=587
SMTP_USER="correo@tudominio.com"
SMTP_PASS="contraseña-de-aplicacion"
NOTIFICACIONES_EMAIL_DESTINO="donde-recibes-los-avisos@tudominio.com"
